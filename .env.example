# Valores de exemplo. Nunca registre valores reais neste arquivo.
# Para desenvolvimento local, substitua APP_USER e APP_PASSWORD por credenciais locais.
DATABASE_URL="postgresql://APP_USER:APP_PASSWORD@localhost:5432/gerador_requisitos?schema=public"

# Gere localmente com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Nunca versione o valor real.
AUTH_SESSION_SECRET=""

# Integração de IA: o mock permite desenvolvimento sem chave e sem chamadas externas.
# Use "gemini" somente para análise real com uma chave local configurada.
AI_PROVIDER="mock"
GEMINI_API_KEY=""
# Esta variável só é lida quando AI_PROVIDER="gemini".
# Confirme a disponibilidade do modelo na sua conta do Google AI Studio antes do uso.
GEMINI_MODEL="gemini-3.8-flash"
